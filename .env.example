# Perfil activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# Usuario temporal de seguridad para dev/test.
# En prod el modulo auth reemplazara estas variables.
ACCIONESUD_SECURITY_USUARIO=usuario-dev
ACCIONESUD_SECURITY_CLAVE=clave-dev

# Base de datos local (docker compose). Estos son los valores por defecto en dev.
POSTGRES_DB=acciones_ud
POSTGRES_USER=acciones
POSTGRES_PASSWORD=acciones_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origenes permitidos para el frontend (CORS), separados por coma.
ACCIONESUD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Proveedores de datos de mercado (SCRUM-23) ----
# Alpaca (NYSE, NASDAQ)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# API de datos de mercado (SCRUM-24) y feed del plan gratuito
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex
# Limitador de cuota: tope de diseño = ALPACA_PORCENTAJE_TOPE % de ALPACA_LIMITE_LLAMADAS_MINUTO
ALPACA_LIMITE_LLAMADAS_MINUTO=200
ALPACA_PORCENTAJE_TOPE=60

# Alpha Vantage (LSE, TSE, ASX)
ALPHA_VANTAGE_API_KEY=

# Alternativas internacionales (opcionales)
FINNHUB_API_KEY=
POLYGON_API_KEY=

# ---- Servicio de Datos de Mercado con caché (SCRUM-24) ----
# Redis (docker compose up -d redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Actualizador: una llamada agrupada a Alpaca cada intervalo (5000 ms = 12 llamadas/min)
COTIZACIONES_INTERVALO_MS=5000
COTIZACIONES_UMBRAL_ANTIGUEDAD_SEGUNDOS=15
COTIZACIONES_ACTUALIZADOR_HABILITADO=true
# redis | memoria
COTIZACIONES_CACHE_TIPO=redis
COTIZACIONES_CACHE_TTL_HORAS=168

# Mercados internacionales (LSE, TSE, ASX): Alpha Vantage -> Finnhub -> Polygon
COTIZACIONES_INTERNACIONAL_INTERVALO_MS=60000
COTIZACIONES_INTERNACIONAL_UMBRAL_SEGUNDOS=1800
COTIZACIONES_INTERNACIONAL_TICKERS_POR_CICLO=1
COTIZACIONES_INTERNACIONAL_PORCENTAJE_TOPE=60
# Limites de los planes (gratuitos por defecto)
ALPHA_VANTAGE_LIMITE_LLAMADAS_MINUTO=5
ALPHA_VANTAGE_LIMITE_LLAMADAS_DIA=25
FINNHUB_LIMITE_LLAMADAS_MINUTO=60
POLYGON_LIMITE_LLAMADAS_MINUTO=5

# Cache de respuestas de proveedores (opcional)
# enabled: true/false | ttl en segundos
MERCADOS_CACHE_ENABLED=true
MERCADOS_CACHE_TTL_SEGUNDOS=60

# ---- Alta en Alpaca Broker API sandbox (SCRUM-20) ----
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALTA_REINTENTO_HABILITADO=true
ALTA_REINTENTO_INTERVALO_SEGUNDOS=60