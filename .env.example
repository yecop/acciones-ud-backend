# Perfil activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# ---- Autenticacion SCRUM-21 ----
# Secreto HMAC para JWT. Debe tener al menos 32 caracteres en todos los perfiles.
AUTH_JWT_SECRET=dev-secreto-jwt-acciones-ud-2026-32bytes-minimo
AUTH_JWT_EMISOR=acciones-ud
AUTH_ACCESS_TTL_SEGUNDOS=900
AUTH_REFRESH_TTL_SEGUNDOS=604800

# Codigo MFA, intentos, bloqueo y reenvio.
AUTH_MFA_EXPIRACION_SEGUNDOS=300
AUTH_MFA_MAX_INTENTOS=5
AUTH_MFA_BLOQUEO_SEGUNDOS=900
AUTH_MFA_REENVIO_ESPERA_SEGUNDOS=60
AUTH_MFA_MAX_REENVIOS=3
AUTH_MFA_LONGITUD_CODIGO=6

# Limite de intentos de login.
AUTH_LOGIN_MAX_FALLOS=5
AUTH_LOGIN_VENTANA_SEGUNDOS=900

# Correo saliente. En desarrollo Mailpit escucha en localhost:1025.
MAIL_HOST=localhost
MAIL_PORT=1025
AUTH_CORREO_REMITENTE=no-reply@accionesud.local

# Usuario demo creado solo en el perfil dev.
AUTH_DEMO_CORREO=inversionista@accionesud.local
AUTH_DEMO_CLAVE=Clave123!

# Base de datos local (docker compose). Estos son los valores por defecto en dev.
POSTGRES_DB=acciones_ud
POSTGRES_USER=acciones
POSTGRES_PASSWORD=acciones_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origenes permitidos para el frontend (CORS), separados por coma.
ACCIONESUD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Proveedores de datos de mercado (SCRUM-23) ----
# Alpaca (NYSE, NASDAQ)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpha Vantage (LSE, TSE, ASX)
ALPHA_VANTAGE_API_KEY=

# Alternativas internacionales (opcionales)
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Cache de respuestas de proveedores (opcional)
# enabled: true/false | ttl en segundos
MERCADOS_CACHE_ENABLED=true
MERCADOS_CACHE_TTL_SEGUNDOS=60
