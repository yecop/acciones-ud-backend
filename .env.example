# Perfil activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# Usuario temporal de seguridad para dev/test.
# En prod el modulo auth reemplazara estas variables.
ACCIONESUD_SECURITY_USUARIO=usuario-dev
ACCIONESUD_SECURITY_CLAVE=clave-dev

# Base de datos local (docker compose). Estos son los valores por defecto en dev.
POSTGRES_DB=acciones_ud
POSTGRES_USER=acciones
POSTGRES_PASSWORD=acciones_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origenes permitidos para el frontend (CORS), separados por coma.
ACCIONESUD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Proveedores de datos de mercado (SCRUM-23) ----
# Alpaca (NYSE, NASDAQ)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpha Vantage (LSE, TSE, ASX)
ALPHA_VANTAGE_API_KEY=

# Alternativas internacionales (opcionales)
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Cache de respuestas de proveedores (opcional)
# enabled: true/false | ttl en segundos
MERCADOS_CACHE_ENABLED=true
MERCADOS_CACHE_TTL_SEGUNDOS=60

# ---- Alta en Alpaca Broker API sandbox (SCRUM-20) ----
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALTA_REINTENTO_HABILITADO=true
ALTA_REINTENTO_INTERVALO_SEGUNDOS=60