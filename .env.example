# Perfil activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# Saldo inicial del portafolio simulado
ACCIONESUD_SALDO_INICIAL_SIMULADO=100000.00

# ---- Autenticacion SCRUM-21 ----
# Secreto HMAC para JWT. Debe tener al menos 32 caracteres en todos los perfiles.
# Obligatorio en staging y prod: el arranque falla si falta o está vacío.
AUTH_JWT_SECRET=dev-secreto-jwt-acciones-ud-2026-32bytes-minimo
AUTH_JWT_EMISOR=acciones-ud
AUTH_ACCESS_TTL_SEGUNDOS=900
AUTH_REFRESH_TTL_SEGUNDOS=604800

# Codigo MFA, intentos, bloqueo y reenvio.
AUTH_MFA_EXPIRACION_SEGUNDOS=300
AUTH_MFA_MAX_INTENTOS=5
AUTH_MFA_BLOQUEO_SEGUNDOS=900
AUTH_MFA_REENVIO_ESPERA_SEGUNDOS=60
AUTH_MFA_MAX_REENVIOS=3
AUTH_MFA_LONGITUD_CODIGO=6

# Limite de intentos de login.
AUTH_LOGIN_MAX_FALLOS=5
AUTH_LOGIN_VENTANA_SEGUNDOS=900

# Correo saliente. En desarrollo Mailpit escucha en localhost:1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
AUTH_CORREO_REMITENTE=no-reply@accionesud.local
AUTH_CORREO_ASUNTO=Código de verificación - Acciones UD

# Usuario demo creado solo en el perfil dev.
AUTH_DEMO_CORREO=inversionista@accionesud.local
AUTH_DEMO_CLAVE=Clave123!

# Base de datos local (docker compose). Estos son los valores por defecto en dev.
POSTGRES_DB=acciones_ud
POSTGRES_USER=acciones
POSTGRES_PASSWORD=acciones_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base de datos de staging y produccion. Obligatorias: no tienen valor por defecto.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Origenes permitidos para el frontend (CORS), separados por coma.
# En staging debe incluir la URL publica del frontend; es obligatoria en ese perfil.
ACCIONESUD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Proveedores de datos de mercado (SCRUM-23) ----
# Alpaca (NYSE, NASDAQ)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# API de datos de mercado (SCRUM-24) y feed del plan gratuito
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex
# Limitador de cuota: tope de diseño = ALPACA_PORCENTAJE_TOPE % de ALPACA_LIMITE_LLAMADAS_MINUTO
ALPACA_LIMITE_LLAMADAS_MINUTO=200
ALPACA_PORCENTAJE_TOPE=60

# Alpha Vantage (LSE, TSE, ASX)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co

# Alternativas internacionales (opcionales)
FINNHUB_API_KEY=
POLYGON_API_KEY=

# ---- Servicio de Datos de Mercado con caché (SCRUM-24) ----
# Redis (docker compose up -d redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s
# Actualizador: una llamada agrupada a Alpaca cada intervalo (5000 ms = 12 llamadas/min)
COTIZACIONES_INTERVALO_MS=5000
COTIZACIONES_UMBRAL_ANTIGUEDAD_SEGUNDOS=15
COTIZACIONES_ACTUALIZADOR_HABILITADO=true
# redis | memoria
COTIZACIONES_CACHE_TIPO=redis
COTIZACIONES_CACHE_TTL_HORAS=168

# Mercados internacionales (LSE, TSE, ASX): Alpha Vantage -> Finnhub -> Polygon
COTIZACIONES_INTERNACIONAL_INTERVALO_MS=60000
COTIZACIONES_INTERNACIONAL_UMBRAL_SEGUNDOS=1800
COTIZACIONES_INTERNACIONAL_TICKERS_POR_CICLO=1
COTIZACIONES_INTERNACIONAL_PORCENTAJE_TOPE=60
# Limites de los planes (gratuitos por defecto)
ALPHA_VANTAGE_LIMITE_LLAMADAS_MINUTO=5
ALPHA_VANTAGE_LIMITE_LLAMADAS_DIA=25
FINNHUB_LIMITE_LLAMADAS_MINUTO=60
POLYGON_LIMITE_LLAMADAS_MINUTO=5

# Cache de respuestas de proveedores (opcional)
# enabled: true/false | ttl en segundos
MERCADOS_CACHE_ENABLED=true
MERCADOS_CACHE_TTL_SEGUNDOS=60

# ---- Alta en Alpaca Broker API sandbox (SCRUM-20) ----
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALPACA_BROKER_TIMEOUT_SEGUNDOS=5
ALTA_REINTENTO_HABILITADO=true
ALTA_REINTENTO_INTERVALO_SEGUNDOS=60
ALTA_REINTENTO_MAXIMO=20

# ---- Notificaciones (SCRUM-51) ----
# EMAIL por SMTP (usa MAIL_* de arriba; en dev, Mailpit en http://localhost:8025) o "simulado".
# SMS y WhatsApp siguen simulados hasta integrar Twilio. Reintento con espera exponencial.
NOTIFICACIONES_CANAL_EMAIL=smtp
NOTIFICACIONES_CORREO_REMITENTE=no-reply@accionesud.local
NOTIFICACIONES_REINTENTO_HABILITADO=true
NOTIFICACIONES_REINTENTO_INTERVALO_MS=30000
NOTIFICACIONES_REINTENTO_MAX_INTENTOS=5
NOTIFICACIONES_REINTENTO_ESPERA_BASE_SEGUNDOS=30
