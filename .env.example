# Perfil activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# Usuario temporal de seguridad para dev/test.
# En prod el modulo auth reemplazara estas variables.
ACCIONESUD_SECURITY_USUARIO=usuario-dev
ACCIONESUD_SECURITY_CLAVE=clave-dev

# Base de datos local (docker compose). Estos son los valores por defecto en dev.
POSTGRES_DB=acciones_ud
POSTGRES_USER=acciones
POSTGRES_PASSWORD=acciones_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432